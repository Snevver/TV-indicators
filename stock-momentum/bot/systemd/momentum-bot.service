# Momentum rebalance check. Runs daily, speaks once a month.
#
# Install:
#   sudo cp momentum-bot.{service,timer} /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now momentum-bot.timer
#
# Edit User, WorkingDirectory, ExecStart and the CHANGEME in the second
# EnvironmentFile to match where you cloned the repo and who runs it.
# Secrets live in the env files (chmod 600), never in this file — unit files
# are world-readable.

[Unit]
Description=Monthly momentum rebalance check
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=CHANGEME
WorkingDirectory=/home/CHANGEME/tv-indicators/stock-momentum/bot
# Both files, in this order, so the dashboard's settings win -- exactly what
# momentum-web.service does. The leading '-' means a file that does not exist
# yet is not an error; ~/.config/momentum is only created on the first save.
EnvironmentFile=-/etc/momentum-bot.env
EnvironmentFile=-/home/CHANGEME/.config/momentum/momentum.env
# Two runs, in order: the demo account first (traded automatically), then live
# (which waits for a Discord reaction). --env is read before the broker module
# is imported, so it also picks the key pair.
ExecStart=/home/CHANGEME/tv-indicators/stock-momentum/bot/.venv/bin/python momentum_bot.py --env demo
ExecStart=/home/CHANGEME/tv-indicators/stock-momentum/bot/.venv/bin/python momentum_bot.py --env live

# Two price downloads, either of which can hang; do not leave a run wedged.
TimeoutStartSec=600
