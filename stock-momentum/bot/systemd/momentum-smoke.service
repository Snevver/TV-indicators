# Reads back your Discord reaction and acts on it -- for the smoke test and
# for the monthly batch of real orders. One timer, both jobs.
#
# WHY A TIMER AND NOT A LISTENER
# Discord cannot call us. A reaction sits on the message until something asks
# whether it is there, so either you press a button or this asks for you. It is
# the same question either way; the timer just asks every minute so a reaction
# turns into an order on its own.
#
# Costs nothing when idle: with nothing outstanding, --poll reads two small files
# and exits without touching the network. When something IS waiting it stays for
# about ninety seconds asking every few seconds, so a reaction turns into an
# order in about the time it takes you to look up from Discord -- not on the next
# minute tick.
#
# It polls BOTH in the same run. Doing one per tick would let a smoke position you
# forgot to close starve the monthly rebalance behind it.
#
# A gateway websocket or an interactions webhook would be truly instant, but both
# need either a permanent connection or a public HTTPS endpoint, and this box is
# deliberately not reachable from the internet.
#
# Install (edit CHANGEME first):
#   sudo cp momentum-smoke.{service,timer} /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now momentum-smoke.timer
#
# Already installed? The same two lines are enough -- copy and daemon-reload. The
# unit name has not changed, so there is nothing to enable again.

[Unit]
Description=Act on a Discord reaction (smoke test and monthly orders)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=CHANGEME
WorkingDirectory=/home/CHANGEME/tv-indicators/stock-momentum/bot
EnvironmentFile=-/etc/momentum-bot.env
EnvironmentFile=-/home/CHANGEME/.config/momentum/momentum.env
# --env live: the poller acts on the live approval batch. The demo account is
# traded and settled in one pass by the nightly run, so there is nothing here
# for it to poll.
ExecStart=/home/CHANGEME/tv-indicators/stock-momentum/bot/.venv/bin/python momentum_bot.py --poll --env live
TimeoutStartSec=180
