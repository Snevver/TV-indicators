# Two runs a weeknight. The backtest buys at the CLOSE of the first trading day
# of the month, so the useful run is the one that lands before that close:
# 21:00 CEST is 15:00 in New York, an hour before the 16:00 close. Winter shifts
# both by an hour together, so the gap holds; check it if you are not on CE(S)T. The 22:30 run is the safety net: if the earlier one did not
# yet see a bar dated in the new month, the later one will. Whichever fires
# first records the rebalance, and the other becomes a no-op — the bot keys off
# the newest daily bar and its own state, not the clock, so a duplicate run
# posts nothing.

[Unit]
Description=Run the momentum rebalance check on weeknights

[Timer]
OnCalendar=Mon..Fri 21:00
OnCalendar=Mon..Fri 22:30
# If the machine was off at both times, run at the next opportunity.
Persistent=true
# Stagger slightly so the data provider does not see a stampede on the 1st.
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
