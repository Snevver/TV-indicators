*.pyc

# Intraday bars are ~500MB and fully rebuildable from build_intraday.py.
# Price data does not belong in git.
**/data/*_m5.csv
**/data/*_m15.csv
**/data/*_h1.csv
**/data/*_h4.csv
**/data/stocks/
__pycache__/
*.pyc

# Virtual environments are per-machine and hundreds of megabytes. The bot and
# the web app each build their own; neither belongs in the repo.
.venv/
**/.venv/
venv/
