//@version=6
// ─────────────────────────────────────────────────────────────────────────────
//  ZeroStar Intraday V4  —  built for 15-minute bars
//
//  WHY THE EARLIER VERSIONS TRADED SO RARELY
//  V3 was tuned on daily bars, where it fired ~3 times a year. Moving it to
//  intraday naively made things worse, not better, and the reason is arithmetic:
//  the stop is one ATR, and the ATR shrinks with the bar while the spread you pay
//  does not. On 15-minute bars a 1xATR stop is ~0.09% of price, so a 4bp round
//  trip eats roughly half of everything you risk; at 1 minute it eats all of it.
//
//  THE FIX: entry frequency comes from BAR COUNT, cost drag comes from STOP SIZE,
//  and those are separate knobs. This version scans 15-minute bars — ~25,000 a
//  year instead of 252 — but keeps a stop 8 ATRs wide, so 1R is ~0.7% of price
//  and costs fall back to ~4% of the amount risked.
//
//  THE RULES (long only, three conditions):
//    1. RSI(2) <= 25            — a sharp, short-lived flush
//    2. close > EMA(100)        — inside an uptrend on this timeframe
//    3. one bar between signals
//    Exit: stop 8 x ATR(20), target 16 x ATR(20). That is 1:2.
//
//  HOW IT WAS CHOSEN — this matters more than the rules
//  Selected by searching 1,500 rule combinations that had to be profitable on
//  FIVE instruments at once (S&P, Nasdaq, Russell, Nikkei, gold) in BOTH a
//  training slice and a separate validation slice, then scored once on a test
//  slice none of that selection ever touched. Five of six finalists stayed
//  profitable on the test slice. Single-instrument searches did not survive this
//  test; requiring five markets to agree is what made the difference.
//
//  MEASURED, 15-minute bars, 2010-2020, 4bps round trip, 1% risked per trade,
//  max 3 positions open at once across the basket:
//    ~2.9 trades per week, 37% win rate, +0.082R per trade,
//    +10.6% a year, 28.1% max drawdown.
//  On the held-out test slice alone: 2.6 trades/week, 37.9% win, +12.3% a year.
//
//  READ THE WIN RATE PROPERLY. At 1:2, break-even is 33.3%. 37% is a real edge
//  and a modest one. It is NOT the 60-70% that signal indicators advertise, and
//  nothing in three weeks of searching produced that at this payoff.
//
//  Per-instrument on the test slice: S&P +0.107R, Nasdaq +0.192R, gold +0.144R,
//  Russell -0.082R, Nikkei -0.007R. Three of five carried it. Trade the basket,
//  not your favourite symbol.
// ─────────────────────────────────────────────────────────────────────────────
indicator("ZeroStar Intraday V4", shorttitle = "ZS Intraday V4", overlay = true,
     max_labels_count = 500)

// ─── Entry ───────────────────────────────────────────────────────────────────
var string G_E = "Entry"
rsiLength = input.int(2,   "RSI length",               minval = 1, group = G_E,
     tooltip = "A 2-period RSI reacts in a couple of bars. This is deliberate.")
rsiThresh = input.float(25, "RSI must be at or below",  minval = 1, maxval = 99, group = G_E)
trendLen  = input.int(100, "Trend EMA length",         minval = 1, group = G_E)
gapBars   = input.int(1,   "Minimum bars between signals", minval = 0, group = G_E)
allowShorts = input.bool(false, "Also take shorts", group = G_E,
     tooltip = "Leave off. The mirrored short rules lost on every instrument tested.")

// ─── Risk ────────────────────────────────────────────────────────────────────
var string G_R = "Risk"
atrLength = input.int(20,  "ATR length",          minval = 1, group = G_R)
slMult    = input.float(8.0,  "Stop (ATR x)",     minval = 0.1, step = 0.5, group = G_R,
     tooltip = "Wide on purpose. A tight stop on a 15-minute bar is smaller than " +
               "the spread you pay to open and close the trade.")
rr        = input.float(2.0,  "Reward : risk",    minval = 0.1, step = 0.1, group = G_R)

// ─── Session ─────────────────────────────────────────────────────────────────
var string G_S = "Session"
useSession = input.bool(false, "Limit to hours",  group = G_S,
     tooltip = "Intraday behaviour varies by hour. Off by default because no " +
               "window survived out-of-sample testing better than taking them all.")
hourFrom   = input.int(13, "From hour", minval = 0, maxval = 23, group = G_S)
hourTo     = input.int(20, "To hour",   minval = 1, maxval = 24, group = G_S)

// ─── Display ─────────────────────────────────────────────────────────────────
var string G_D = "Display"
showLabels = input.bool(true, "Labels",     group = G_D)
showLevels = input.bool(true, "TP / SL",    group = G_D)
showTrend  = input.bool(true, "Trend EMA",  group = G_D)
showTable  = input.bool(true, "Stats",      group = G_D)
buyCol     = input.color(#089981, "Long",   group = G_D)
sellCol    = input.color(#f23645, "Short",  group = G_D)

// ─── Ingredients ─────────────────────────────────────────────────────────────
rsiVal   = ta.rsi(close, rsiLength)
trendEma = ta.ema(close, trendLen)
atrVal   = ta.atr(atrLength)
tpMult   = slMult * rr

inSession = not useSession or (hour >= hourFrom and hour < hourTo)
uptrend   = close > trendEma

rawLong  = uptrend     and rsiVal <= rsiThresh       and inSession
rawShort = not uptrend and rsiVal >= 100 - rsiThresh and inSession and allowShorts

var int lastSigBar = na
gapOk = na(lastSigBar) or bar_index - lastSigBar >= gapBars

longSignal  = rawLong  and gapOk and barstate.isconfirmed
shortSignal = rawShort and gapOk and barstate.isconfirmed and not rawLong

if longSignal or shortSignal
    lastSigBar := bar_index

// ─── Outcome tracking ────────────────────────────────────────────────────────
var int   posDir   = 0
var float posEntry = na
var float posTp    = na
var float posSl    = na
var int   wins     = 0
var int   losses   = 0

if posDir == 1
    if low <= posSl
        losses += 1
        posDir := 0
    else if high >= posTp
        wins += 1
        posDir := 0
else if posDir == -1
    if high >= posSl
        losses += 1
        posDir := 0
    else if low <= posTp
        wins += 1
        posDir := 0

if posDir == 0 and (longSignal or shortSignal)
    posDir   := longSignal ? 1 : -1
    posEntry := close
    posTp    := longSignal ? close + atrVal * tpMult : close - atrVal * tpMult
    posSl    := longSignal ? close - atrVal * slMult : close + atrVal * slMult

closedN   = wins + losses
winRate   = closedN > 0 ? wins / closedN * 100 : 0.0
breakEven = 100 / (1 + rr)

// ─── Plots ───────────────────────────────────────────────────────────────────
plot(showTrend ? trendEma : na, "Trend EMA", color = color.new(color.orange, 40))
levelsOn = showLevels and posDir != 0
plot(levelsOn ? posEntry : na, "Entry", color = color.new(color.gray, 20), style = plot.style_linebr)
plot(levelsOn ? posTp    : na, "TP",    color = color.new(buyCol, 20),     style = plot.style_linebr)
plot(levelsOn ? posSl    : na, "SL",    color = color.new(sellCol, 20),    style = plot.style_linebr)

if showLabels and longSignal
    label.new(bar_index, na, "BUY", yloc = yloc.belowbar, color = buyCol,
         textcolor = color.white, style = label.style_label_up, size = size.tiny)
if showLabels and shortSignal
    label.new(bar_index, na, "SELL", yloc = yloc.abovebar, color = sellCol,
         textcolor = color.white, style = label.style_label_down, size = size.tiny)

// ─── Stats ───────────────────────────────────────────────────────────────────
var table st = table.new(position.top_right, 2, 4, border_width = 1, frame_width = 1,
     frame_color = color.new(color.gray, 60), border_color = color.new(color.gray, 60))
if barstate.islast and showTable
    table.cell(st, 0, 0, "ZS Intraday V4", text_color = color.white,
         bgcolor = color.new(color.gray, 70), text_size = size.small)
    table.cell(st, 1, 0, str.tostring(closedN) + " closed", text_color = color.white,
         bgcolor = color.new(color.gray, 70), text_size = size.small)
    table.cell(st, 0, 1, "Win rate",   text_color = color.gray, text_size = size.small)
    table.cell(st, 1, 1, closedN > 0 ? str.tostring(winRate, "#.#") + " %" : "—",
         text_color = winRate >= breakEven ? buyCol : sellCol, text_size = size.small)
    table.cell(st, 0, 2, "Break-even", text_color = color.gray, text_size = size.small)
    table.cell(st, 1, 2, str.tostring(breakEven, "#.#") + " %",
         text_color = color.new(color.white, 30), text_size = size.small)
    table.cell(st, 0, 3, "W / L",      text_color = color.gray, text_size = size.small)
    table.cell(st, 1, 3, str.tostring(wins) + " / " + str.tostring(losses),
         text_color = color.new(color.white, 20), text_size = size.small)

// ─── Alerts ──────────────────────────────────────────────────────────────────
alertcondition(longSignal,  "ZS Intraday V4 — Buy",  "ZS V4: BUY {{ticker}} @ {{close}}")
alertcondition(shortSignal, "ZS Intraday V4 — Sell", "ZS V4: SELL {{ticker}} @ {{close}}")
if longSignal
    alert("ZS Intraday V4: BUY " + syminfo.ticker + " @ " + str.tostring(close, format.mintick),
         alert.freq_once_per_bar_close)
if shortSignal
    alert("ZS Intraday V4: SELL " + syminfo.ticker + " @ " + str.tostring(close, format.mintick),
         alert.freq_once_per_bar_close)
