//@version=6
// ─────────────────────────────────────────────────────────────────────────────
//  ZeroStar Intraday V4 — STRATEGY  (15-minute bars)
//
//  Rule block copied verbatim from zerostar-intraday-v4.pine; keep them in sync.
//  Entries are market orders, so they fill at the OPEN of the bar after the
//  signal — the same assumption the Python backtest makes.
//
//  SET COSTS IN PROPERTIES. This strategy lives or dies on them: the stop is
//  ~0.7% of price, so every extra basis point of spread is ~0.15% of what you
//  risk. The 0.02% default below is an index-CFD figure. Stocks are worse.
// ─────────────────────────────────────────────────────────────────────────────
strategy("ZeroStar Intraday V4 Strategy", shorttitle = "ZS V4 ST", overlay = true,
     pyramiding = 0, initial_capital = 10000,
     default_qty_type = strategy.percent_of_equity, default_qty_value = 10,
     commission_type = strategy.commission.percent, commission_value = 0.02,
     slippage = 1, calc_on_every_tick = false)

var string G_E = "Entry"
rsiLength = input.int(2,   "RSI length",               minval = 1, group = G_E)
rsiThresh = input.float(25, "RSI must be at or below",  minval = 1, maxval = 99, group = G_E)
trendLen  = input.int(100, "Trend EMA length",         minval = 1, group = G_E)
gapBars   = input.int(1,   "Minimum bars between signals", minval = 0, group = G_E)
allowShorts = input.bool(false, "Also take shorts", group = G_E)

var string G_R = "Risk"
atrLength = input.int(20,  "ATR length",       minval = 1, group = G_R)
slMult    = input.float(8.0, "Stop (ATR x)",   minval = 0.1, step = 0.5, group = G_R)
rr        = input.float(2.0, "Reward : risk",  minval = 0.1, step = 0.1, group = G_R)

var string G_S = "Session"
useSession = input.bool(false, "Limit to hours", group = G_S)
hourFrom   = input.int(13, "From hour", minval = 0, maxval = 23, group = G_S)
hourTo     = input.int(20, "To hour",   minval = 1, maxval = 24, group = G_S)

var string G_W = "Backtest window"
useWindow = input.bool(false, "Limit to a date range", group = G_W)
startTime = input.time(timestamp("01 Jan 2010 00:00 +0000"), "From", group = G_W)
endTime   = input.time(timestamp("01 Jan 2030 00:00 +0000"), "To",   group = G_W)
inWindow  = not useWindow or (time >= startTime and time <= endTime)

// ─── Ingredients ─────────────────────────────────────────────────────────────
rsiVal   = ta.rsi(close, rsiLength)
trendEma = ta.ema(close, trendLen)
atrVal   = ta.atr(atrLength)
tpMult   = slMult * rr

inSession = not useSession or (hour >= hourFrom and hour < hourTo)
uptrend   = close > trendEma

rawLong  = uptrend     and rsiVal <= rsiThresh       and inSession
rawShort = not uptrend and rsiVal >= 100 - rsiThresh and inSession and allowShorts

var int lastSigBar = na
gapOk = na(lastSigBar) or bar_index - lastSigBar >= gapBars

longSignal  = rawLong  and gapOk
shortSignal = rawShort and gapOk and not rawLong

if longSignal or shortSignal
    lastSigBar := bar_index

// ─── Orders ──────────────────────────────────────────────────────────────────
var float entryAtr = na

if inWindow and strategy.position_size == 0 and longSignal
    entryAtr := atrVal
    strategy.entry("L", strategy.long)
if inWindow and strategy.position_size == 0 and shortSignal
    entryAtr := atrVal
    strategy.entry("S", strategy.short)

avgPrice = strategy.position_avg_price
if strategy.position_size > 0 and not na(entryAtr)
    strategy.exit("L exit", from_entry = "L",
         limit = avgPrice + entryAtr * tpMult, stop = avgPrice - entryAtr * slMult)
if strategy.position_size < 0 and not na(entryAtr)
    strategy.exit("S exit", from_entry = "S",
         limit = avgPrice - entryAtr * tpMult, stop = avgPrice + entryAtr * slMult)
if useWindow and not inWindow and strategy.position_size != 0
    strategy.close_all(comment = "window end")

plot(ta.ema(close, trendLen), "Trend EMA", color = color.new(color.orange, 40))
plotshape(longSignal,  "Buy",  style = shape.triangleup,   location = location.belowbar,
     color = #089981, size = size.tiny)
plotshape(shortSignal, "Sell", style = shape.triangledown, location = location.abovebar,
     color = #f23645, size = size.tiny)
