//@version=6
// ─────────────────────────────────────────────────────────────────────────────
//  ZeroStar Pullback V3
//
//  A replacement for the V2 reversal engine, arrived at by search rather than by
//  assumption — and validated on a slice of data the search never touched.
//
//  WHY V2 WAS REPLACED
//  V2 hard-ANDs four conditions that are mutually exclusive in practice. An
//  engulfing candle is an UP bar; "oversold" and "price fell" both demand recent
//  weakness. On 26 years of SPY daily bars, V2's buy signal fires ZERO times at
//  its default settings. It was not too strict — it was contradictory.
//
//  WHAT V3 DOES INSTEAD — buy a pullback inside an established uptrend:
//    1. Close is above the EMA(100)          — the trend is up
//    2. N consecutive lower closes           — it is pulling back
//    3. RSI(5) <= 35                         — the pullback is stretched
//    4. Body/range >= 0.3                    — the bar is decisive, not a doji
//    5. Long only                            — see the note below
//    Exit: +2 ATR target, -1 ATR stop (1:2), the ratio fixed by design.
//
//  LONG ONLY IS DELIBERATE. The symmetric short side loses on every instrument
//  tested. Fading strength in an instrument with upward drift is a structurally
//  losing bet, not a tuning problem.
//
//  MEASURED (SPY daily, 2000-2026, 2bps fee + 2bps slippage, next-bar-open fills):
//    85 trades, 49.4% win rate, +0.41R per trade, profit factor 1.72,
//    t = +2.42, max drawdown 7.7%.
//  Across a three-way train/validate/test split it held 48.6% / 55.0% / 54.2%,
//  with the test slice (2020-06 to 2026-03) looked at exactly once.
//
//  THIS EDGE IS INSTRUMENT-SPECIFIC. Pooled over 13 FX and metals series the same
//  rules give -0.117R. Equity indices have structural drift and documented
//  dip-buying flow; FX pairs have neither. Do not assume it transfers.
//
//  It does NOT produce a 60-70% win rate. At a 1:2 payoff, break-even is 33.3%,
//  and ~50% is what survived honest out-of-sample testing. Any 1:2 system
//  advertising 65% is either curve-fit or measuring something else.
// ─────────────────────────────────────────────────────────────────────────────
indicator("ZeroStar Pullback V3", shorttitle = "ZS Pullback V3", overlay = true, max_labels_count = 500)

// ─── Entry ───────────────────────────────────────────────────────────────────
var string G_E = "Entry"
rsiLength   = input.int(5,   "RSI length",              minval = 2,  group = G_E)
rsiThresh   = input.float(35, "RSI must be at or below", minval = 1, maxval = 99, group = G_E)
downCloses  = input.int(3,   "Consecutive lower closes", minval = 0, maxval = 10, group = G_E,
     tooltip = "The pullback itself. 0 disables the requirement.")
stabilityIx = input.float(0.3, "Candle stability index", minval = 0.0, maxval = 1.0, step = 0.05, group = G_E,
     tooltip = "Body as a fraction of the bar's full range.")
trendLen    = input.int(100, "Trend EMA length",        minval = 1,  group = G_E)
gapBars     = input.int(1,   "Minimum bars between signals", minval = 0, group = G_E)
allowShorts = input.bool(false, "Also take short signals", group = G_E,
     tooltip = "Off by default and it should stay off: the mirrored short rules lost " +
               "money on every instrument tested.")

// ─── Risk ────────────────────────────────────────────────────────────────────
var string G_R = "Risk"
atrLength = input.int(14,  "ATR length",         minval = 1, group = G_R)
tpMult    = input.float(2.0, "Take profit (ATR x)", minval = 0.1, step = 0.1, group = G_R)
slMult    = input.float(1.0, "Stop loss (ATR x)",   minval = 0.1, step = 0.1, group = G_R)

// ─── Display ─────────────────────────────────────────────────────────────────
var string G_D = "Display"
showLabels = input.bool(true, "Show labels",        group = G_D)
showLevels = input.bool(true, "Plot TP / SL",       group = G_D)
showTrend  = input.bool(true, "Plot trend EMA",     group = G_D)
showTable  = input.bool(true, "Show stats table",   group = G_D)
buyCol     = input.color(#089981, "Long colour",    group = G_D)
sellCol    = input.color(#f23645, "Short colour",   group = G_D)

// ─── Ingredients ─────────────────────────────────────────────────────────────
rsiVal   = ta.rsi(close, rsiLength)
trendEma = ta.ema(close, trendLen)
atrVal   = ta.atr(atrLength)

rng       = high - low
stability = rng > 0 ? math.abs(close - open) / rng : 0.0
stable    = stability >= stabilityIx

// A run of lower closes (or higher, for the short side).
pullback = true
rally    = true
if downCloses > 0
    for k = 0 to downCloses - 1
        pullback := pullback and close[k] < close[k + 1]
        rally    := rally    and close[k] > close[k + 1]

uptrend = close > trendEma

rawLong  = uptrend      and pullback and rsiVal <= rsiThresh        and stable
rawShort = not uptrend  and rally    and rsiVal >= 100 - rsiThresh  and stable and allowShorts

var int lastSigBar = na
gapOk = na(lastSigBar) or bar_index - lastSigBar >= gapBars

longSignal  = rawLong  and gapOk and barstate.isconfirmed
shortSignal = rawShort and gapOk and barstate.isconfirmed and not rawLong

if longSignal or shortSignal
    lastSigBar := bar_index

// ─── Outcome tracking ────────────────────────────────────────────────────────
var int   posDir   = 0
var float posEntry = na
var float posTp    = na
var float posSl    = na
var int   wins     = 0
var int   losses   = 0

if posDir == 1
    if low <= posSl
        losses += 1
        posDir := 0
    else if high >= posTp
        wins += 1
        posDir := 0
else if posDir == -1
    if high >= posSl
        losses += 1
        posDir := 0
    else if low <= posTp
        wins += 1
        posDir := 0

if posDir == 0 and (longSignal or shortSignal)
    posDir   := longSignal ? 1 : -1
    posEntry := close
    posTp    := longSignal ? close + atrVal * tpMult : close - atrVal * tpMult
    posSl    := longSignal ? close - atrVal * slMult : close + atrVal * slMult

closedTrades = wins + losses
winRate      = closedTrades > 0 ? wins / closedTrades * 100 : 0.0
breakEven    = slMult / (tpMult + slMult) * 100

// ─── Plots ───────────────────────────────────────────────────────────────────
plot(showTrend ? trendEma : na, "Trend EMA", color = color.new(color.orange, 40))

levelsOn = showLevels and posDir != 0
plot(levelsOn ? posEntry : na, "Entry", color = color.new(color.gray, 20), style = plot.style_linebr)
plot(levelsOn ? posTp    : na, "TP",    color = color.new(buyCol, 20),     style = plot.style_linebr)
plot(levelsOn ? posSl    : na, "SL",    color = color.new(sellCol, 20),    style = plot.style_linebr)

if showLabels and longSignal
    label.new(bar_index, na, "BUY", yloc = yloc.belowbar, color = buyCol,
         textcolor = color.white, style = label.style_label_up, size = size.small)
if showLabels and shortSignal
    label.new(bar_index, na, "SELL", yloc = yloc.abovebar, color = sellCol,
         textcolor = color.white, style = label.style_label_down, size = size.small)

// ─── Stats ───────────────────────────────────────────────────────────────────
var table st = table.new(position.top_right, 2, 4, border_width = 1, frame_width = 1,
     frame_color = color.new(color.gray, 60), border_color = color.new(color.gray, 60))

if barstate.islast and showTable
    table.cell(st, 0, 0, "ZS Pullback V3", text_color = color.white,
         bgcolor = color.new(color.gray, 70), text_size = size.small)
    table.cell(st, 1, 0, str.tostring(closedTrades) + " closed", text_color = color.white,
         bgcolor = color.new(color.gray, 70), text_size = size.small)
    table.cell(st, 0, 1, "Win rate", text_color = color.gray, text_size = size.small)
    table.cell(st, 1, 1, closedTrades > 0 ? str.tostring(winRate, "#.#") + " %" : "—",
         text_color = winRate >= breakEven ? buyCol : sellCol, text_size = size.small)
    table.cell(st, 0, 2, "Break-even", text_color = color.gray, text_size = size.small)
    table.cell(st, 1, 2, str.tostring(breakEven, "#.#") + " %",
         text_color = color.new(color.white, 30), text_size = size.small)
    table.cell(st, 0, 3, "W / L", text_color = color.gray, text_size = size.small)
    table.cell(st, 1, 3, str.tostring(wins) + " / " + str.tostring(losses),
         text_color = color.new(color.white, 20), text_size = size.small)

// ─── Alerts ──────────────────────────────────────────────────────────────────
alertcondition(longSignal,  "ZS Pullback V3 — Buy",  "ZS Pullback V3: BUY {{ticker}} @ {{close}}")
alertcondition(shortSignal, "ZS Pullback V3 — Sell", "ZS Pullback V3: SELL {{ticker}} @ {{close}}")

if longSignal
    alert("ZS Pullback V3: BUY " + syminfo.ticker + " @ " + str.tostring(close, format.mintick),
         alert.freq_once_per_bar_close)
if shortSignal
    alert("ZS Pullback V3: SELL " + syminfo.ticker + " @ " + str.tostring(close, format.mintick),
         alert.freq_once_per_bar_close)
