//@version=6
// ─────────────────────────────────────────────────────────────────────────────
//  ZeroStar Alpha V2 — STRATEGY
//
//  The exact signal engine from zerostar-alpha-v2.pine, wired into TradingView's
//  Strategy Tester so it can be backtested with real fees, slippage and an
//  equity curve. Keep the two files in sync: the rules below are copied verbatim
//  from the indicator.
//
//  Order handling: entries are plain market orders, so with the default
//  "process orders on close" OFF they fill at the OPEN of the bar after the
//  signal. That is deliberate — filling at the signal bar's own close flatters
//  the results.
//
//  Set commission and slippage in the Properties tab of the Strategy Tester.
//  A backtest with zero costs is not a backtest.
// ─────────────────────────────────────────────────────────────────────────────
strategy("ZeroStar Alpha V2 Strategy", shorttitle = "ZS Alpha V2 ST", overlay = true,
     pyramiding = 0, initial_capital = 10000,
     default_qty_type = strategy.percent_of_equity, default_qty_value = 10,
     commission_type = strategy.commission.percent, commission_value = 0.04,
     slippage = 2, calc_on_every_tick = false, max_labels_count = 500)

// ─── Signal engine (identical to the indicator) ──────────────────────────────
var string G_SIG = "Signal engine"
stabilityIndex = input.float(0.5, "Candle stability index", minval = 0.0, maxval = 1.0, step = 0.05, group = G_SIG)
rsiIndex       = input.int(70, "RSI index", minval = 50, maxval = 100, group = G_SIG)
rsiLength      = input.int(14, "RSI length", minval = 2, group = G_SIG)
deltaLength    = input.int(4, "Candle delta length", minval = 3, group = G_SIG)
requireEngulf  = input.bool(true, "Require engulfing candle", group = G_SIG)

var string G_FLT = "Filters"
noRepeat  = input.bool(true, "Disable repeating signals", group = G_FLT)
labelGap  = input.int(6, "Minimum bars between signals", minval = 0, group = G_FLT)
useTrend  = input.bool(false, "EMA trend filter", group = G_FLT)
trendLen  = input.int(200, "EMA length", minval = 1, group = G_FLT)
trendMode = input.string("Counter trend", "Trend mode", options = ["With trend", "Counter trend"], group = G_FLT)
useVol    = input.bool(false, "Require volume expansion", group = G_FLT)
volLen    = input.int(20, "Volume average length", minval = 1, group = G_FLT)
volMult   = input.float(1.5, "Volume multiple", minval = 0.1, step = 0.1, group = G_FLT)

var string G_RISK = "Risk"
atrLength = input.int(14, "ATR length", minval = 1, group = G_RISK)
tpMult    = input.float(2.0, "Take profit (ATR x)", minval = 0.1, step = 0.1, group = G_RISK)
slMult    = input.float(1.0, "Stop loss (ATR x)", minval = 0.1, step = 0.1, group = G_RISK)
maxBars   = input.int(0, "Force exit after N bars (0 = never)", minval = 0, group = G_RISK)

var string G_DIR = "Direction"
allowLongs  = input.bool(true, "Take long signals", group = G_DIR)
allowShorts = input.bool(true, "Take short signals", group = G_DIR)

var string G_SESS = "Backtest window"
useWindow = input.bool(false, "Limit to a date range", group = G_SESS)
startTime = input.time(timestamp("01 Jan 2020 00:00 +0000"), "From", group = G_SESS)
endTime   = input.time(timestamp("01 Jan 2030 00:00 +0000"), "To",   group = G_SESS)
inWindow  = not useWindow or (time >= startTime and time <= endTime)

// ─── Ingredients ─────────────────────────────────────────────────────────────
candleRange = high - low
candleBody  = math.abs(close - open)
stability   = candleRange > 0 ? candleBody / candleRange : 0.0
stable      = stability >= stabilityIndex

rsi        = ta.rsi(close, rsiLength)
oversold   = rsi <= 100 - rsiIndex
overbought = rsi >= rsiIndex

fell = close < close[deltaLength]
rose = close > close[deltaLength]

bullEngulf = close > open and close[1] < open[1] and close >= open[1] and open <= close[1]
bearEngulf = close < open and close[1] > open[1] and close <= open[1] and open >= close[1]
bullPattern = requireEngulf ? bullEngulf : close > open
bearPattern = requireEngulf ? bearEngulf : close < open

trendEma  = ta.ema(close, trendLen)
aboveEma  = close > trendEma
withTrend = trendMode == "With trend"
trendOkBuy  = not useTrend ? true : (withTrend ? aboveEma : not aboveEma)
trendOkSell = not useTrend ? true : (withTrend ? not aboveEma : aboveEma)

volAvg = ta.sma(nz(volume), volLen)
volOk  = not useVol ? true : (volAvg > 0 and nz(volume) > volAvg * volMult)

rawBuy  = bullPattern and stable and oversold   and fell and trendOkBuy  and volOk
rawSell = bearPattern and stable and overbought and rose and trendOkSell and volOk

var int lastSignalBar = na
var int lastDir       = 0
gapOk = na(lastSignalBar) or bar_index - lastSignalBar >= labelGap

buySignal  = rawBuy  and gapOk and (not noRepeat or lastDir !=  1)
sellSignal = rawSell and gapOk and (not noRepeat or lastDir != -1)

if buySignal
    lastSignalBar := bar_index
    lastDir       := 1
else if sellSignal
    lastSignalBar := bar_index
    lastDir       := -1

// ─── Orders ──────────────────────────────────────────────────────────────────
atr = ta.atr(atrLength)

var float entryAtr  = na
var int   entryBar  = na

flat = strategy.position_size == 0

if inWindow and flat and buySignal and allowLongs
    entryAtr := atr
    entryBar := bar_index
    strategy.entry("L", strategy.long)

if inWindow and flat and sellSignal and allowShorts
    entryAtr := atr
    entryBar := bar_index
    strategy.entry("S", strategy.short)

// Levels are anchored to the ACTUAL fill price, not the signal bar's close.
avg = strategy.position_avg_price

if strategy.position_size > 0 and not na(entryAtr)
    strategy.exit("L exit", from_entry = "L",
         limit = avg + entryAtr * tpMult, stop = avg - entryAtr * slMult)

if strategy.position_size < 0 and not na(entryAtr)
    strategy.exit("S exit", from_entry = "S",
         limit = avg - entryAtr * tpMult, stop = avg + entryAtr * slMult)

if maxBars > 0 and strategy.position_size != 0 and not na(entryBar) and bar_index - entryBar >= maxBars
    strategy.close_all(comment = "timeout")

// Close anything still open when the backtest window ends.
if useWindow and not inWindow and strategy.position_size != 0
    strategy.close_all(comment = "window end")

// ─── Visuals ─────────────────────────────────────────────────────────────────
plot(useTrend ? trendEma : na, "Trend EMA", color = color.new(color.orange, 40))
plotshape(buySignal,  "Buy",  style = shape.triangleup,   location = location.belowbar,
     color = #089981, size = size.tiny)
plotshape(sellSignal, "Sell", style = shape.triangledown, location = location.abovebar,
     color = #f23645, size = size.tiny)
