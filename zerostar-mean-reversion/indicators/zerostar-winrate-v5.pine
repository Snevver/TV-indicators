//@version=6
// ─────────────────────────────────────────────────────────────────────────────
//  ZeroStar Win-Rate V5  —  15-minute bars, 1:1 payoff
//
//  Built for one request: win noticeably more often than it loses. It does —
//  ~53-56% against a 50% break-even. Read the trade-off before using it.
//
//  THE TRADE-OFF, measured on the same held-out slice:
//      V4 (1:2 payoff)   37.2% win rate   →  +12.3% a year
//      V5 (1:1 payoff)   53.1% win rate   →   +4.4% a year
//  A higher win rate is not free. At 1:1 each winner only pays for one loser, so
//  the same edge produces less money. V5 is the easier system to actually sit
//  through; V4 is the one that compounds faster. That is the whole choice.
//
//  WHY WIN RATE ALONE IS A TRAP: break-even is set by the payoff.
//      1:2   → 33.3%      1:1  → 50.0%
//      1:0.75 → 57.1%     1:0.5 → 66.7%
//  A 70% win rate at 1:0.5 LOSES money. "Wins more than it loses" only means
//  profit when the win rate beats its own row.
//
//  THE RULES (long only, three conditions):
//    1. Two consecutive lower closes    — a short pullback
//    2. close > EMA(50)                 — inside an uptrend
//    3. inside the afternoon session    — see below
//    Exit: stop 16 x ATR(14), target 16 x ATR(14). Equal. That is 1:1.
//
//  THE SESSION FILTER IS LOAD-BEARING. Without it the same rules give 51.6% and
//  +0.012R on the test slice; with it, 53.1% and +0.041R. That is not a fitted
//  spike: every window from 14:00 to 23:00 tested positive (53-57% win rate), a
//  broad plateau rather than one lucky hour. An independent scan of hourly
//  autocorrelation, run before this search, had already flagged these hours as
//  the mean-reverting part of the day.
//
//  Hours are as your chart stamps them, and chart timezone varies by broker and
//  symbol. Check where your afternoon actually falls before trusting the default.
//
//  MEASURED, 15-minute bars, 5 instruments (S&P, Nasdaq, Russell, Nikkei, gold),
//  2010-2020, 4bps round trip, 1% risked per trade, max 5 concurrent:
//    full history  2.4 trades/week, 56.2% win, +13.0% a year, 20.0% max drawdown
//    test slice    2.3 trades/week, 53.1% win,  +4.4% a year, 16.4% max drawdown
//
//  Trade the basket. On the test slice four of the five instruments were
//  positive; a single symbol is a much noisier bet than the group.
// ─────────────────────────────────────────────────────────────────────────────
indicator("ZeroStar Win-Rate V5", shorttitle = "ZS WinRate V5", overlay = true,
     max_labels_count = 500)

// ─── Entry ───────────────────────────────────────────────────────────────────
var string G_E = "Entry"
downCloses = input.int(2, "Consecutive lower closes", minval = 1, maxval = 10, group = G_E)
trendLen   = input.int(50, "Trend EMA length",        minval = 1, group = G_E)
gapBars    = input.int(1,  "Minimum bars between signals", minval = 0, group = G_E)
allowShorts = input.bool(false, "Also take shorts", group = G_E,
     tooltip = "Leave off. Mirrored shorts lost on every instrument tested.")

// ─── Risk ────────────────────────────────────────────────────────────────────
var string G_R = "Risk"
atrLength = input.int(14, "ATR length",      minval = 1, group = G_R)
slMult    = input.float(16.0, "Stop (ATR x)", minval = 0.1, step = 0.5, group = G_R,
     tooltip = "Wide on purpose. A tight stop on a 15-minute bar is smaller than " +
               "the spread you pay to get in and out.")
rr        = input.float(1.0, "Reward : risk", minval = 0.1, step = 0.1, group = G_R,
     tooltip = "1.0 is this indicator's point. Raising it lifts profit and lowers " +
               "the win rate; 2.0 turns it into V4's payoff profile.")

// ─── Session ─────────────────────────────────────────────────────────────────
var string G_S = "Session"
useSession = input.bool(true, "Limit to session hours", group = G_S,
     tooltip = "On by default — this filter is most of the edge.")
hourFrom   = input.int(13, "From hour", minval = 0, maxval = 23, group = G_S)
hourTo     = input.int(23, "To hour",   minval = 1, maxval = 24, group = G_S)

// ─── Display ─────────────────────────────────────────────────────────────────
var string G_D = "Display"
showLabels = input.bool(true, "Labels",    group = G_D)
showLevels = input.bool(true, "TP / SL",   group = G_D)
showTrend  = input.bool(true, "Trend EMA", group = G_D)
showTable  = input.bool(true, "Stats",     group = G_D)
buyCol     = input.color(#089981, "Long",  group = G_D)
sellCol    = input.color(#f23645, "Short", group = G_D)

// ─── Ingredients ─────────────────────────────────────────────────────────────
trendEma = ta.ema(close, trendLen)
atrVal   = ta.atr(atrLength)
tpMult   = slMult * rr

inSession = not useSession or (hour >= hourFrom and hour < hourTo)
uptrend   = close > trendEma

pullback = true
rally    = true
for k = 0 to downCloses - 1
    pullback := pullback and close[k] < close[k + 1]
    rally    := rally    and close[k] > close[k + 1]

rawLong  = uptrend     and pullback and inSession
rawShort = not uptrend and rally    and inSession and allowShorts

var int lastSigBar = na
gapOk = na(lastSigBar) or bar_index - lastSigBar >= gapBars

longSignal  = rawLong  and gapOk and barstate.isconfirmed
shortSignal = rawShort and gapOk and barstate.isconfirmed and not rawLong

if longSignal or shortSignal
    lastSigBar := bar_index

// ─── Outcome tracking ────────────────────────────────────────────────────────
var int   posDir   = 0
var float posEntry = na
var float posTp    = na
var float posSl    = na
var int   wins     = 0
var int   losses   = 0

if posDir == 1
    if low <= posSl
        losses += 1
        posDir := 0
    else if high >= posTp
        wins += 1
        posDir := 0
else if posDir == -1
    if high >= posSl
        losses += 1
        posDir := 0
    else if low <= posTp
        wins += 1
        posDir := 0

if posDir == 0 and (longSignal or shortSignal)
    posDir   := longSignal ? 1 : -1
    posEntry := close
    posTp    := longSignal ? close + atrVal * tpMult : close - atrVal * tpMult
    posSl    := longSignal ? close - atrVal * slMult : close + atrVal * slMult

closedN   = wins + losses
winRate   = closedN > 0 ? wins / closedN * 100 : 0.0
breakEven = 100 / (1 + rr)

// ─── Plots ───────────────────────────────────────────────────────────────────
plot(showTrend ? trendEma : na, "Trend EMA", color = color.new(color.orange, 40))
levelsOn = showLevels and posDir != 0
plot(levelsOn ? posEntry : na, "Entry", color = color.new(color.gray, 20), style = plot.style_linebr)
plot(levelsOn ? posTp    : na, "TP",    color = color.new(buyCol, 20),     style = plot.style_linebr)
plot(levelsOn ? posSl    : na, "SL",    color = color.new(sellCol, 20),    style = plot.style_linebr)

if showLabels and longSignal
    label.new(bar_index, na, "BUY", yloc = yloc.belowbar, color = buyCol,
         textcolor = color.white, style = label.style_label_up, size = size.tiny)
if showLabels and shortSignal
    label.new(bar_index, na, "SELL", yloc = yloc.abovebar, color = sellCol,
         textcolor = color.white, style = label.style_label_down, size = size.tiny)

// ─── Stats ───────────────────────────────────────────────────────────────────
var table st = table.new(position.top_right, 2, 4, border_width = 1, frame_width = 1,
     frame_color = color.new(color.gray, 60), border_color = color.new(color.gray, 60))
if barstate.islast and showTable
    table.cell(st, 0, 0, "ZS Win-Rate V5", text_color = color.white,
         bgcolor = color.new(color.gray, 70), text_size = size.small)
    table.cell(st, 1, 0, str.tostring(closedN) + " closed", text_color = color.white,
         bgcolor = color.new(color.gray, 70), text_size = size.small)
    table.cell(st, 0, 1, "Win rate",   text_color = color.gray, text_size = size.small)
    table.cell(st, 1, 1, closedN > 0 ? str.tostring(winRate, "#.#") + " %" : "—",
         text_color = winRate >= breakEven ? buyCol : sellCol, text_size = size.small)
    table.cell(st, 0, 2, "Break-even", text_color = color.gray, text_size = size.small)
    table.cell(st, 1, 2, str.tostring(breakEven, "#.#") + " %",
         text_color = color.new(color.white, 30), text_size = size.small)
    table.cell(st, 0, 3, "W / L",      text_color = color.gray, text_size = size.small)
    table.cell(st, 1, 3, str.tostring(wins) + " / " + str.tostring(losses),
         text_color = color.new(color.white, 20), text_size = size.small)

// ─── Alerts ──────────────────────────────────────────────────────────────────
alertcondition(longSignal,  "ZS V5 — Buy",  "ZS V5: BUY {{ticker}} @ {{close}}")
alertcondition(shortSignal, "ZS V5 — Sell", "ZS V5: SELL {{ticker}} @ {{close}}")
if longSignal
    alert("ZS Win-Rate V5: BUY " + syminfo.ticker + " @ " + str.tostring(close, format.mintick),
         alert.freq_once_per_bar_close)
if shortSignal
    alert("ZS Win-Rate V5: SELL " + syminfo.ticker + " @ " + str.tostring(close, format.mintick),
         alert.freq_once_per_bar_close)
