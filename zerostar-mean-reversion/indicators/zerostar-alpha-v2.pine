//@version=6
// ─────────────────────────────────────────────────────────────────────────────
//  ZeroStar Alpha V2
//
//  An original, open implementation of a reversal-signal engine in the style of
//  the well-known "candle stability + RSI + delta" family of label indicators.
//  Nothing here is decompiled or copied from a protected script — every rule
//  below is implemented from a plain-language description of the technique.
//
//  Signal recipe (BUY, mirrored for SELL):
//    1. Price has fallen over the last `Candle delta length` bars
//    2. RSI is in the oversold zone
//    3. The current candle is a bullish engulfing candle
//    4. The candle is "stable" — its body dominates its wicks
//    5. Optional trend / volume filters agree
//    6. The bar has closed (non-repainting)
// ─────────────────────────────────────────────────────────────────────────────
indicator("ZeroStar Alpha V2", shorttitle = "ZS Alpha V2", overlay = true, max_labels_count = 500)

// ─── Signal engine ───────────────────────────────────────────────────────────
var string G_SIG = "Signal engine"

stabilityIndex = input.float(0.5, "Candle stability index", minval = 0.0, maxval = 1.0, step = 0.05, group = G_SIG,
     tooltip = "Ratio of candle body to total candle range (0-1). Higher = only accept decisive, low-wick candles.")
rsiIndex       = input.int(70, "RSI index", minval = 50, maxval = 100, group = G_SIG,
     tooltip = "How stretched RSI must be. 70 means: buy below RSI 30, sell above RSI 70. Higher = stricter.")
rsiLength      = input.int(14, "RSI length", minval = 2, group = G_SIG)
deltaLength    = input.int(4, "Candle delta length", minval = 3, group = G_SIG,
     tooltip = "Over how many bars price must have moved against the signal direction before a reversal counts.")
requireEngulf  = input.bool(true, "Require engulfing candle", group = G_SIG,
     tooltip = "Off = any candle closing in the signal direction qualifies (many more signals).")
confirmOnClose = input.bool(true, "Confirm on bar close (non-repainting)", group = G_SIG,
     tooltip = "Signals are only committed once the bar closes, so labels never appear and vanish intrabar.")

// ─── Filters ─────────────────────────────────────────────────────────────────
var string G_FLT = "Filters"

noRepeat  = input.bool(true, "Disable repeating signals", group = G_FLT,
     tooltip = "Never print two signals of the same direction in a row.")
labelGap  = input.int(6, "Minimum bars between signals", minval = 0, group = G_FLT)
useTrend  = input.bool(false, "EMA trend filter", group = G_FLT)
trendLen  = input.int(200, "EMA length", minval = 1, group = G_FLT)
trendMode = input.string("Counter trend", "Trend mode", options = ["With trend", "Counter trend"], group = G_FLT,
     tooltip = "With trend: buy only above the EMA. Counter trend: buy only below it (dip buying).")
useVol    = input.bool(false, "Require volume expansion", group = G_FLT)
volLen    = input.int(20, "Volume average length", minval = 1, group = G_FLT)
volMult   = input.float(1.5, "Volume multiple", minval = 0.1, step = 0.1, group = G_FLT)

// ─── Performance tracking ────────────────────────────────────────────────────
var string G_PERF = "Performance tracking"

trackPerf  = input.bool(true, "Track win rate", group = G_PERF,
     tooltip = "Simulates one position per signal with an ATR take-profit and stop-loss, then tallies the results.")
atrLength  = input.int(14, "ATR length", minval = 1, group = G_PERF)
tpMult     = input.float(2.0, "Take profit (ATR x)", minval = 0.1, step = 0.1, group = G_PERF)
slMult     = input.float(1.0, "Stop loss (ATR x)", minval = 0.1, step = 0.1, group = G_PERF)
showLevels = input.bool(true, "Plot entry / TP / SL of the open signal", group = G_PERF)

// ─── Visuals ─────────────────────────────────────────────────────────────────
var string G_VIS = "Visuals"

showLabels = input.bool(true, "Show BUY / SELL labels", group = G_VIS)
showPrice  = input.bool(false, "Show price on label", group = G_VIS)
labelSize  = input.string("Small", "Label size", options = ["Tiny", "Small", "Normal", "Large"], group = G_VIS)
buyCol     = input.color(#089981, "Buy colour", group = G_VIS)
sellCol    = input.color(#f23645, "Sell colour", group = G_VIS)
showTable  = input.bool(true, "Show stats table", group = G_VIS)
tablePos   = input.string("Top right", "Stats table position", options = ["Top right", "Top left", "Bottom right", "Bottom left"], group = G_VIS)

lblSize = switch labelSize
    "Tiny"   => size.tiny
    "Small"  => size.small
    "Normal" => size.normal
    =>          size.large

tPos = switch tablePos
    "Top right"    => position.top_right
    "Top left"     => position.top_left
    "Bottom right" => position.bottom_right
    =>                position.bottom_left

// ─── Ingredients ─────────────────────────────────────────────────────────────
candleRange = high - low
candleBody  = math.abs(close - open)
stability   = candleRange > 0 ? candleBody / candleRange : 0.0
stable      = stability >= stabilityIndex

rsi        = ta.rsi(close, rsiLength)
oversold   = rsi <= 100 - rsiIndex
overbought = rsi >= rsiIndex

fell = close < close[deltaLength]
rose = close > close[deltaLength]

bullEngulf = close > open and close[1] < open[1] and close >= open[1] and open <= close[1]
bearEngulf = close < open and close[1] > open[1] and close <= open[1] and open >= close[1]

bullPattern = requireEngulf ? bullEngulf : close > open
bearPattern = requireEngulf ? bearEngulf : close < open

trendEma = ta.ema(close, trendLen)
aboveEma = close > trendEma
withTrend = trendMode == "With trend"
trendOkBuy  = not useTrend ? true : (withTrend ? aboveEma : not aboveEma)
trendOkSell = not useTrend ? true : (withTrend ? not aboveEma : aboveEma)

volAvg = ta.sma(nz(volume), volLen)
volOk  = not useVol ? true : (volAvg > 0 and nz(volume) > volAvg * volMult)

rawBuy  = bullPattern and stable and oversold   and fell and trendOkBuy  and volOk
rawSell = bearPattern and stable and overbought and rose and trendOkSell and volOk

// ─── Signal gating ───────────────────────────────────────────────────────────
var int lastSignalBar = na
var int lastDir       = 0

confirmed = not confirmOnClose or barstate.isconfirmed
gapOk     = na(lastSignalBar) or bar_index - lastSignalBar >= labelGap

buySignal  = rawBuy  and confirmed and gapOk and (not noRepeat or lastDir !=  1)
sellSignal = rawSell and confirmed and gapOk and (not noRepeat or lastDir != -1)

if buySignal
    lastSignalBar := bar_index
    lastDir       := 1
else if sellSignal
    lastSignalBar := bar_index
    lastDir       := -1

// ─── Simulated outcome tracking ──────────────────────────────────────────────
atr = ta.atr(atrLength)

var int   posDir   = 0
var float posEntry = na
var float posTp    = na
var float posSl    = na
var int   wins     = 0
var int   losses   = 0
var int   taken    = 0

if trackPerf
    // Resolve any open position first, so the entry bar itself can never close it.
    if posDir == 1
        if low <= posSl
            losses += 1
            posDir := 0
        else if high >= posTp
            wins += 1
            posDir := 0
    else if posDir == -1
        if high >= posSl
            losses += 1
            posDir := 0
        else if low <= posTp
            wins += 1
            posDir := 0

    if posDir == 0 and (buySignal or sellSignal)
        posDir   := buySignal ? 1 : -1
        posEntry := close
        posTp    := buySignal ? close + atr * tpMult : close - atr * tpMult
        posSl    := buySignal ? close - atr * slMult : close + atr * slMult
        taken    += 1

closed  = wins + losses
winRate = closed > 0 ? wins / closed * 100 : 0.0

// ─── Plots ───────────────────────────────────────────────────────────────────
plot(useTrend ? trendEma : na, "Trend EMA", color = color.new(color.orange, 40))

levelsOn = showLevels and trackPerf and posDir != 0
plot(levelsOn ? posEntry : na, "Entry", color = color.new(color.gray, 20),  style = plot.style_linebr)
plot(levelsOn ? posTp    : na, "TP",    color = color.new(buyCol, 20),      style = plot.style_linebr)
plot(levelsOn ? posSl    : na, "SL",    color = color.new(sellCol, 20),     style = plot.style_linebr)

if showLabels and buySignal
    label.new(bar_index, na, showPrice ? "BUY\n" + str.tostring(close, format.mintick) : "BUY",
         yloc = yloc.belowbar, color = buyCol, textcolor = color.white,
         style = label.style_label_up, size = lblSize)

if showLabels and sellSignal
    label.new(bar_index, na, showPrice ? "SELL\n" + str.tostring(close, format.mintick) : "SELL",
         yloc = yloc.abovebar, color = sellCol, textcolor = color.white,
         style = label.style_label_down, size = lblSize)

// ─── Stats table ─────────────────────────────────────────────────────────────
var table stats = table.new(tPos, 2, 5, border_width = 1, frame_width = 1,
     frame_color = color.new(color.gray, 60), border_color = color.new(color.gray, 60))

if barstate.islast and showTable and trackPerf
    table.cell(stats, 0, 0, "ZeroStar Alpha V2", text_color = color.white, bgcolor = color.new(color.gray, 70), text_size = size.small)
    table.cell(stats, 1, 0, str.tostring(taken) + " signals", text_color = color.white, bgcolor = color.new(color.gray, 70), text_size = size.small)
    table.cell(stats, 0, 1, "Win rate",  text_color = color.gray, text_size = size.small)
    table.cell(stats, 1, 1, closed > 0 ? str.tostring(winRate, "#.##") + " %" : "—",
         text_color = winRate >= 50 ? buyCol : sellCol, text_size = size.small)
    table.cell(stats, 0, 2, "Wins",      text_color = color.gray, text_size = size.small)
    table.cell(stats, 1, 2, str.tostring(wins),   text_color = buyCol,  text_size = size.small)
    table.cell(stats, 0, 3, "Losses",    text_color = color.gray, text_size = size.small)
    table.cell(stats, 1, 3, str.tostring(losses), text_color = sellCol, text_size = size.small)
    table.cell(stats, 0, 4, "Open",      text_color = color.gray, text_size = size.small)
    table.cell(stats, 1, 4, posDir == 1 ? "Long" : posDir == -1 ? "Short" : "flat",
         text_color = color.new(color.white, 20), text_size = size.small)

// ─── Alerts ──────────────────────────────────────────────────────────────────
alertcondition(buySignal,                "ZS Alpha V2 — Buy",  "ZeroStar Alpha V2: BUY {{ticker}} @ {{close}}")
alertcondition(sellSignal,               "ZS Alpha V2 — Sell", "ZeroStar Alpha V2: SELL {{ticker}} @ {{close}}")
alertcondition(buySignal or sellSignal,  "ZS Alpha V2 — Any",  "ZeroStar Alpha V2: signal on {{ticker}} @ {{close}}")

if buySignal
    alert("ZeroStar Alpha V2: BUY " + syminfo.ticker + " @ " + str.tostring(close, format.mintick), alert.freq_once_per_bar_close)
if sellSignal
    alert("ZeroStar Alpha V2: SELL " + syminfo.ticker + " @ " + str.tostring(close, format.mintick), alert.freq_once_per_bar_close)
